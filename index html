<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#144D17">
  <meta name="description" content="農家さんのための簡単・直感的な農業青色申告・確定申告支援Webアプリ">
  <title>農家さんのらくらく確定申告 | 農業青色申告ナビ</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Vue 3 CDN -->
  <script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></script>

  <style>
    body {
      background-color: #EBF2EC;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Sans", "Meiryo", sans-serif;
      -webkit-tap-highlight-color: transparent;
    }
    /* 屋外作業・手袋でも押しやすいタップ領域（最低60px） */
    .btn-touch-lg { min-height: 64px; }
    .btn-touch-md { min-height: 52px; }
    /* スクロールバーの非表示（アプリ風デザイン） */
    ::-webkit-scrollbar { display: none; }
  </style>
</head>
<body class="flex justify-center min-h-screen text-gray-800 antialiased selection:bg-green-200">

  <div id="app" class="w-full max-w-md bg-[#F4F7F4] flex flex-col min-h-screen shadow-2xl relative pb-20">

    <!-- 1. アプリヘッダー -->
    <header class="bg-[#144D17] text-white px-5 pt-6 pb-4 shadow-md flex justify-between items-center sticky top-0 z-30">
      <div>
        <span class="text-[11px] bg-[#2E7D32] text-green-100 font-extrabold px-2 py-0.5 rounded tracking-wide">
          2026年分 農業所得用
        </span>
        <h1 class="text-xl font-black mt-1 tracking-tight">🌱 農家らくらく申告</h1>
      </div>
      <button 
        @click="showReportModal = true" 
        class="bg-[#2E7D32] hover:bg-[#388E3C] active:scale-95 transition border border-green-400 text-white font-extrabold text-xs px-3 py-2 rounded-xl flex items-center shadow"
      >
        📊 決算集計
      </button>
    </header>

    <!-- AI-OCR解析中アニメーション -->
    <div v-if="isAnalyzing" class="fixed inset-0 bg-black/85 flex flex-col justify-center items-center z-50 text-white px-6 text-center">
      <div class="animate-spin rounded-full h-14 w-14 border-4 border-white border-t-transparent mb-4"></div>
      <p class="text-lg font-black tracking-wide">伝票・レシートをAI解析中...</p>
      <p class="text-xs text-gray-300 mt-2">金額・日付・農業用科目を自動抽出しています</p>
    </div>

    <!-- 2. 所得・収支サマリーカード -->
    <div class="p-4">
      <div class="bg-white rounded-2xl p-4 shadow-sm border border-gray-200">
        <div class="flex justify-between items-center text-xs font-bold text-gray-500">
          <span>差引所得 (青色申告控除前)</span>
          <span class="text-green-700 bg-green-50 px-2 py-0.5 rounded font-bold">家事按分反映済</span>
        </div>
        <div class="text-3xl font-black my-1 tracking-tight" :class="netIncome >= 0 ? 'text-[#1B5E20]' : 'text-red-600'">
          ¥ {{ netIncome.toLocaleString() }}
        </div>
        <div class="flex justify-between text-xs font-bold text-gray-600 pt-2 border-t border-gray-100">
          <span>🌾 売上総額: ¥{{ totalIncome.toLocaleString() }}</span>
          <span>📦 経費合計: ¥{{ totalExpense.toLocaleString() }}</span>
        </div>
      </div>
    </div>

    <!-- 3. 屋外作業用 超大型アクションボタン -->
    <div class="px-4 space-y-2.5">
      <!-- レシート撮影（スマホカメラ直結） -->
      <label class="btn-touch-lg w-full bg-[#E65100] hover:bg-[#EF6C00] active:scale-[0.98] transition text-white rounded-2xl flex items-center px-4 cursor-pointer shadow-md">
        <span class="text-3xl mr-3">📷</span>
        <div class="text-left flex-1">
          <div class="text-base font-black leading-tight">レシートを撮って自動入力</div>
          <div class="text-[11px] text-orange-200 font-medium">カメラ撮影 ➔ 金額・費目をAI自動読み取り</div>
        </div>
        <input type="file" accept="image/*" capture="environment" class="hidden" @change="handleCameraScan">
      </label>

      <div class="grid grid-cols-2 gap-2">
        <!-- JA精算書の一発分解シミュレーション -->
        <button 
          @click="simulateJASettlement" 
          class="btn-touch-md bg-white active:bg-gray-100 border-2 border-green-700 rounded-xl flex items-center justify-center p-2 shadow-sm transition active:scale-[0.98]"
        >
          <span class="text-xl mr-2">📑</span>
          <div class="text-left">
            <div class="text-xs font-black text-green-900 leading-tight">JA精算書取込</div>
            <div class="text-[10px] text-gray-500 font-medium">相殺仕訳を一発分解</div>
          </div>
        </button>

        <!-- 手動入力 -->
        <button 
          @click="openExpenseModal()" 
          class="btn-touch-md bg-[#2E7D32] hover:bg-[#1B5E20] active:scale-[0.98] transition text-white rounded-xl flex items-center justify-center p-2 shadow-sm"
        >
          <span class="text-xl mr-2">✏️</span>
          <span class="text-sm font-black">手動で記録</span>
        </button>
      </div>
    </div>

    <!-- 4. 取引履歴一覧 -->
    <div class="p-4 flex-1">
      <div class="flex justify-between items-center mb-2.5">
        <h2 class="font-black text-sm text-gray-800">取引履歴 ({{ transactions.length }}件)</h2>
        <span class="text-[11px] text-gray-500 font-medium">端末内保存中</span>
      </div>

      <div v-if="transactions.length === 0" class="text-center py-12 text-gray-400">
        <p class="text-4xl mb-2">🚜</p>
        <p class="text-sm font-bold text-gray-600">記録がまだありません</p>
        <p class="text-xs mt-1">上のボタンからレシートを撮影してください</p>
      </div>

      <div class="space-y-2">
        <div 
          v-for="item in transactions" 
          :key="item.id" 
          class="bg-white p-3 rounded-xl border border-gray-200 shadow-sm flex items-center transition"
        >
          <!-- レシート画像サムネイル -->
          <div 
            v-if="item.receiptUri" 
            @click="zoomImage = item.receiptUri" 
            class="w-12 h-14 bg-gray-100 rounded-lg overflow-hidden relative cursor-pointer border border-gray-200 flex-shrink-0"
          >
            <img :src="item.receiptUri" class="w-full h-full object-cover" alt="レシート原本">
            <span class="absolute bottom-0 right-0 bg-black/60 text-[9px] text-white px-1 rounded-tl">🔍</span>
          </div>
          <div v-else class="w-12 h-14 bg-green-50 rounded-lg flex items-center justify-center text-xl flex-shrink-0">
            {{ item.type === 'income' ? '🌾' : '📄' }}
          </div>

          <!-- 詳細情報 -->
          <div class="ml-3 flex-1 min-w-0">
            <div class="flex items-center space-x-1 mb-0.5">
              <span :class="item.type === 'income' ? 'bg-green-700 text-white' : 'bg-orange-600 text-white'" class="text-[10px] font-bold px-1.5 py-0.5 rounded">
                {{ item.type === 'income' ? '売上' : '経費' }}
              </span>
              <span class="bg-green-100 text-green-900 text-[10px] font-bold px-1.5 py-0.5 rounded">
                {{ item.officialAccount }}
              </span>
            </div>
            <p class="font-extrabold text-sm text-gray-900 truncate">{{ item.categoryName }}</p>
            <p v-if="item.memo" class="text-xs text-gray-500 truncate">{{ item.memo }}</p>
            <p class="text-[10px] text-gray-400 mt-0.5">{{ item.date }}</p>
          </div>

          <!-- 金額 & 削除 -->
          <div class="text-right ml-2 flex-shrink-0">
            <div class="font-black text-base" :class="item.type === 'income' ? 'text-green-800' : 'text-red-600'">
              {{ item.type === 'income' ? '+' : '-' }}¥{{ item.finalAmount.toLocaleString() }}
            </div>
            <div v-if="item.businessRatio < 1.0" class="text-[10px] text-orange-600 font-extrabold">
              按分{{ Math.round(item.businessRatio * 100) }}%
            </div>
            <button @click="deleteTransaction(item.id)" class="text-gray-400 hover:text-red-500 text-xs mt-1 font-bold">削除</button>
          </div>
        </div>
      </div>
    </div>

    <!-- ==========================================
        MODAL 1: 支出手動・修正モーダル
    =========================================== -->
    <div v-if="showInputModal" class="fixed inset-0 bg-black/60 z-40 flex justify-center items-end sm:items-center p-0 sm:p-4">
      <div class="w-full max-w-md bg-white rounded-t-3xl sm:rounded-2xl max-h-[92vh] flex flex-col overflow-hidden animate-in slide-in-from-bottom">
        <div class="px-5 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
          <button @click="showInputModal = false" class="text-sm font-bold text-gray-500">キャンセル</button>
          <h3 class="font-black text-base text-green-900">支出の記録</h3>
          <span class="w-10"></span>
        </div>

        <div class="p-5 overflow-y-auto space-y-4">
          <!-- レシート画像プレビュー -->
          <div v-if="form.receiptUri" class="bg-gray-50 p-2 rounded-xl border border-gray-200 text-center relative">
            <img :src="form.receiptUri" class="h-32 mx-auto rounded object-contain" alt="添付レシート">
            <button @click="form.receiptUri = null" class="absolute top-2 right-2 bg-red-600 text-white text-xs px-2 py-1 rounded shadow font-bold">✕ 削除</button>
          </div>

          <!-- 金額入力 -->
          <div>
            <label class="block text-xs font-black text-gray-700 mb-1">支払金額 (税込)</label>
            <div class="flex items-center bg-gray-100 rounded-xl px-3 border-2 border-green-600">
              <span class="text-2xl font-black text-green-700 mr-2">¥</span>
              <input v-model.number="form.amount" type="number" inputmode="numeric" placeholder="0" class="w-full bg-transparent text-2xl font-black py-2.5 outline-none text-gray-900">
            </div>
          </div>

          <!-- 農業カテゴリーグリッド -->
          <div>
            <label class="block text-xs font-black text-gray-700 mb-1.5">何に使いましたか？</label>
            <div class="grid grid-cols-3 gap-2">
              <button
                v-for="cat in categories"
                :key="cat.id"
                type="button"
                @click="selectCategory(cat)"
                class="p-2.5 rounded-xl border-2 text-center transition flex flex-col items-center justify-center min-h-[64px]"
                :class="form.category.id === cat.id ? 'border-green-600 bg-green-50 text-green-950 font-black' : 'border-gray-200 bg-white text-gray-700'"
              >
                <span class="text-2xl mb-0.5">{{ cat.icon }}</span>
                <span class="text-[11px] leading-tight font-bold">{{ cat.name }}</span>
              </button>
            </div>
          </div>

          <!-- 家事按分トグル -->
          <div class="bg-green-50 p-3 rounded-xl border border-green-200">
            <span class="text-xs font-black text-green-950 block mb-1">🚜 農業用の利用割合 (家事按分)</span>
            <p class="text-[11px] text-green-800 mb-2">軽トラの燃料や作業場電気代など、私用兼用の割合を選択してください。</p>
            <div class="grid grid-cols-3 gap-2">
              <button
                v-for="ratio in [1.0, 0.8, 0.5]"
                :key="ratio"
                type="button"
                @click="form.businessRatio = ratio"
                class="py-2.5 text-xs font-black rounded-lg border text-center transition"
                :class="form.businessRatio === ratio ? 'bg-[#2E7D32] text-white border-green-700 shadow-sm' : 'bg-white text-gray-700 border-green-300'"
              >
                {{ ratio === 1.0 ? '全額 100%' : `${ratio * 100}% 農業用` }}
              </button>
            </div>
          </div>

          <!-- メモ入力 -->
          <div>
            <label class="block text-xs font-black text-gray-700 mb-1">店舗名・品名メモ (任意)</label>
            <input v-model="form.memo" type="text" placeholder="例: コメリで有機配合肥料 3袋" class="w-full bg-gray-100 rounded-xl px-3 py-2.5 text-sm border border-gray-200 outline-none focus:border-green-600">
          </div>
        </div>

        <div class="p-4 border-t border-gray-100 bg-white">
          <button @click="saveExpense" class="w-full btn-touch-md bg-[#144D17] hover:bg-[#1B5E20] active:scale-[0.98] transition text-white font-black text-base rounded-xl shadow-lg">
            この内容で保存する
          </button>
        </div>
      </div>
    </div>

    <!-- ==========================================
        MODAL 2: 決算書集計＆提出用CSV出力
    =========================================== -->
    <div v-if="showReportModal" class="fixed inset-0 bg-black/60 z-40 flex justify-center items-center p-4">
      <div class="w-full max-w-md bg-white rounded-2xl max-h-[90vh] flex flex-col overflow-hidden animate-in fade-in">
        <div class="px-5 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
          <h3 class="font-black text-base text-green-900">青色申告決算書 プレビュー</h3>
          <button @click="showReportModal = false" class="text-sm font-bold text-gray-500">✕ 閉じる</button>
        </div>

        <div class="p-5 overflow-y-auto space-y-4">
          <div class="bg-green-50 p-4 rounded-xl text-center border border-green-200">
            <span class="text-xs font-bold text-green-800">農業所得の試算結果 (差引金額)</span>
            <div class="text-3xl font-black text-[#1B5E20] my-1">¥ {{ netIncome.toLocaleString() }}</div>
            <span class="text-[11px] text-green-700">※ここから青色申告特別控除（最大65万円）が適用されます</span>
          </div>

          <h4 class="font-black text-xs text-gray-700">国税庁 法定科目別 経費集計表</h4>
          <div class="border border-gray-200 rounded-xl overflow-hidden text-xs">
            <div class="bg-gray-100 font-bold px-3 py-2 flex justify-between border-b border-gray-200">
              <span>勘定科目</span>
              <span>申告計上金額</span>
            </div>
            <div class="px-3 py-2 flex justify-between border-b border-gray-100 font-bold text-green-800">
              <span>🌾 農産物売上 (総額)</span>
              <span>¥{{ totalIncome.toLocaleString() }}</span>
            </div>
            <div v-for="acc in officialAccounts" :key="acc" class="px-3 py-2 flex justify-between border-b border-gray-100">
              <span class="text-gray-700 font-medium">{{ acc }}</span>
              <span class="font-extrabold text-gray-900">¥{{ getSubtotalByAccount(acc).toLocaleString() }}</span>
            </div>
          </div>

          <button @click="downloadCSV" class="w-full btn-touch-md bg-[#2E7D32] hover:bg-[#1B5E20] active:scale-[0.98] transition text-white font-black text-sm rounded-xl flex items-center justify-center shadow">
            📄 e-Tax提出用 CSVファイルをダウンロード
          </button>
        </div>
      </div>
    </div>

    <!-- ==========================================
        MODAL 3: レシート原本 拡大表示モーダル
    =========================================== -->
    <div v-if="zoomImage" class="fixed inset-0 bg-black/90 z-50 flex flex-col justify-center items-center p-4" @click="zoomImage = null">
      <button class="absolute top-5 right-5 text-white bg-white/20 px-4 py-2 rounded-full font-bold text-xs">✕ 閉じる</button>
      <img :src="zoomImage" class="max-w-full max-h-[80vh] object-contain rounded-lg shadow-2xl" alt="拡大レシート">
    </div>

  </div>

  <script>
    const { createApp, ref, computed, onMounted } = Vue;

    createApp({
      setup() {
        const officialAccounts = [
          '種苗費', '肥料費', '農薬費', '諸材料費',
          '修繕費', '動力光熱費', '荷造運賃費', '雑費'
        ];

        const categories = [
          { id: 'seeds', name: '種・苗', officialAccount: '種苗費', defaultRatio: 1.0, icon: '🌾' },
          { id: 'fert', name: '肥料', officialAccount: '肥料費', defaultRatio: 1.0, icon: '🧪' },
          { id: 'chem', name: '農薬', officialAccount: '農薬費', defaultRatio: 1.0, icon: '🐛' },
          { id: 'mat', name: '資材・マルチ・箱', officialAccount: '諸材料費', defaultRatio: 1.0, icon: '📦' },
          { id: 'fuel', name: '燃料・軽油 (軽トラ等)', officialAccount: '動力光熱費', defaultRatio: 0.8, icon: '🚜' },
          { id: 'rep', name: '機械修理・工具', officialAccount: '修繕費', defaultRatio: 1.0, icon: '🔧' },
          { id: 'ship', name: '運賃・出荷委託費', officialAccount: '荷造運賃費', defaultRatio: 1.0, icon: '🚚' },
          { id: 'util', name: '作業場電気・用水路', officialAccount: '動力光熱費', defaultRatio: 0.7, icon: '💡' },
          { id: 'etc', name: 'その他消耗品', officialAccount: '雑費', defaultRatio: 1.0, icon: '📄' }
        ];

        // 初期サンプルデータ
        const defaultTransactions = [
          {
            id: 't-1',
            type: 'income',
            date: '2026-09-20',
            categoryName: '直売所売上',
            officialAccount: '農産物売上',
            rawAmount: 185000,
            businessRatio: 1.0,
            finalAmount: 185000,
            memo: '道の駅 9月中旬振込分',
            receiptUri: null
          },
          {
            id: 't-2',
            type: 'expense',
            date: '2026-09-24',
            categoryName: '資材・マルチ・箱',
            officialAccount: '諸材料費',
            rawAmount: 15400,
            businessRatio: 1.0,
            finalAmount: 15400,
            memo: 'コメリ 黒マルチ 5巻',
            receiptUri: null
          }
        ];

        const transactions = ref([]);
        const showInputModal = ref(false);
        const showReportModal = ref(false);
        const zoomImage = ref(null);
        const isAnalyzing = ref(false);

        const form = ref({
          amount: null,
          category: categories[0],
          businessRatio: 1.0,
          memo: '',
          receiptUri: null
        });

        // 起動時にLocalStorageから復元
        onMounted(() => {
          const saved = localStorage.getItem('farm_tax_transactions');
          if (saved) {
            try { 
              transactions.value = JSON.parse(saved); 
            } catch (e) { 
              transactions.value = defaultTransactions; 
            }
          } else {
            transactions.value = defaultTransactions;
          }
        });

        // データ永続化
        const persist = () => {
          localStorage.setItem('farm_tax_transactions', JSON.stringify(transactions.value));
        };

        // 集計
        const totalIncome = computed(() => {
          return transactions.value
            .filter(t => t.type === 'income')
            .reduce((sum, t) => sum + t.finalAmount, 0);
        });

        const totalExpense = computed(() => {
          return transactions.value
            .filter(t => t.type === 'expense')
            .reduce((sum, t) => sum + t.finalAmount, 0);
        });

        const netIncome = computed(() => totalIncome.value - totalExpense.value);

        const getSubtotalByAccount = (accountName) => {
          return transactions.value
            .filter(t => t.type === 'expense' && t.officialAccount === accountName)
            .reduce((sum, t) => sum + t.finalAmount, 0);
        };

        // フォーム制御
        const selectCategory = (cat) => {
          form.value.category = cat;
          form.value.businessRatio = cat.defaultRatio;
        };

        const openExpenseModal = (receiptDataUrl = null) => {
          form.value = {
            amount: null,
            category: categories[0],
            businessRatio: categories[0].defaultRatio,
            memo: '',
            receiptUri: receiptDataUrl
          };
          showInputModal.value = true;
        };

        const saveExpense = () => {
          if (!form.value.amount || form.value.amount <= 0) {
            alert('正しい金額を入力してください');
            return;
          }
          const finalAmount = Math.round(form.value.amount * form.value.businessRatio);
          const newTx = {
            id: 'exp-' + Date.now(),
            type: 'expense',
            date: new Date().toISOString().split('T')[0],
            categoryName: form.value.category.name,
            officialAccount: form.value.category.officialAccount,
            rawAmount: form.value.amount,
            businessRatio: form.value.businessRatio,
            finalAmount: finalAmount,
            memo: form.value.memo.trim(),
            receiptUri: form.value.receiptUri
          };

          transactions.value.unshift(newTx);
          persist();
          showInputModal.value = false;
        };

        const deleteTransaction = (id) => {
          if (confirm('この記録を削除してもよろしいですか？')) {
            transactions.value = transactions.value.filter(t => t.id !== id);
            persist();
          }
        };

        // カメラ撮影＆AI-OCRシミュレーション
        const handleCameraScan = (event) => {
          const file = event.target.files[0];
          if (!file) return;

          const reader = new FileReader();
          reader.onload = (e) => {
            const dataUrl = e.target.result;
            isAnalyzing.value = true;

            setTimeout(() => {
              isAnalyzing.value = false;
              form.value = {
                amount: 8640,
                category: categories.find(c => c.id === 'mat') || categories[0],
                businessRatio: 1.0,
                memo: 'コメリ 有機育苗培土・セルトレイ [AI自動解析]',
                receiptUri: dataUrl
              };
              showInputModal.value = true;
            }, 1100);
          };
          reader.readAsDataURL(file);
          event.target.value = '';
        };

        // JA月次精算書の一発相殺分解
        const simulateJASettlement = () => {
          if (confirm('JA月次精算書（トマト共選出荷）を取り込み、総売上・天引き資材費・手数料を自動分解して登録しますか？')) {
            const today = new Date().toISOString().split('T')[0];
            const batch = [
              {
                id: 'ja-inc-' + Date.now(),
                type: 'income',
                date: today,
                categoryName: 'JA共選出荷売上',
                officialAccount: '農産物売上',
                rawAmount: 320000,
                businessRatio: 1.0,
                finalAmount: 320000,
                memo: 'JA月次精算書 トマト販売総額',
                receiptUri: null
              },
              {
                id: 'ja-box-' + (Date.now() + 1),
                type: 'expense',
                date: today,
                categoryName: '資材・マルチ・箱',
                officialAccount: '諸材料費',
                rawAmount: 26000,
                businessRatio: 1.0,
                finalAmount: 26000,
                memo: 'JA精算書 天引き段ボール代',
                receiptUri: null
              },
              {
                id: 'ja-fee-' + (Date.now() + 2),
                type: 'expense',
                date: today,
                categoryName: '運賃・出荷委託費',
                officialAccount: '荷造運賃費',
                rawAmount: 18000,
                businessRatio: 1.0,
                finalAmount: 18000,
                memo: 'JA精算書 販売手数料・共同利用料',
                receiptUri: null
              }
            ];

            transactions.value = [...batch, ...transactions.value];
            persist();
            alert('精算書を売上・資材代・手数料の3件に自動分解して登録しました！');
          }
        };

        // CSVダウンロード (UTF-8 BOM付き)
        const downloadCSV = () => {
          const header = '日付,区分,日常カテゴリー,青色申告決算科目,支払総額,事業按分割合,申告計上額,メモ\n';
          const rows = transactions.value.map(t =>
            `${t.date},${t.type === 'income' ? '売上' : '経費'},"${t.categoryName}","${t.officialAccount}",${t.rawAmount},${t.businessRatio},${t.finalAmount},"${t.memo}"`
          ).join('\n');

          const bom = new Uint8Array([0xEF, 0xBB, 0xBF]);
          const blob = new Blob([bom, header + rows], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.setAttribute('download', `確定申告_農業所得_${new Date().toISOString().split('T')[0]}.csv`);
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        };

        return {
          officialAccounts,
          categories,
          transactions,
          showInputModal,
          showReportModal,
          zoomImage,
          isAnalyzing,
          form,
          totalIncome,
          totalExpense,
          netIncome,
          selectCategory,
          openExpenseModal,
          saveExpense,
          deleteTransaction,
          handleCameraScan,
          simulateJASettlement,
          getSubtotalByAccount,
          downloadCSV
        };
      }
    }).mount('#app');
  </script>
